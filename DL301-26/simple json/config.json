        {
          "enabled": true,
          "alias": "voltage_a",
          "description": "Phase A voltage",
          "unit": "V",
          "register_type": "input",
          "address": "0x00",
          "scale_factor": 1.0,
          "value_type": "unsigned",
          "data_type": "float32",
          "width": 2,
          "word_order": "low_high"
        },

