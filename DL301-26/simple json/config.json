{
  "config_version": 1,

  "device": {
    "name": "ESP32 Modbus Gateway",
    "poll_interval_ms": 2000
  },

  "rs485": {
    "rx_pin": 13,
    "tx_pin": 14,
    "de_re_pin": -1
  },

  "sensors": [

