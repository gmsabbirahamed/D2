      "id": 1,
      "name": "Selec MFM384 Energy Meter",

      "modbus": {
        "slave_id": 1,
        "baud_rate": 9600,
        "parity": "N",
        "data_bits": 8,
        "stop_bits": 1,
        "retry_attempts": 3,
        "receive_timeout_ms": 200
      },

